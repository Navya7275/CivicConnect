---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  transparentNavOnLoad?: boolean;
}

const { 
  title = "CivicConnect | AI-Powered Indian Law & Welfare Schemes Assistant", 
  description = "Understand Indian laws and search government welfare schemes using plain language, backed by verified source citations.",
  transparentNavOnLoad = false
} = Astro.props;

const pathname = Astro.url.pathname;
const isApp = pathname.startsWith('/assistant');
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Google Fonts Preconnect for Inter and JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body class="bg-[#f5f5f7] text-foreground h-full flex flex-col antialiased">
    <!-- Skip to Main Content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 btn btn-primary btn-sm">
      Skip to main content
    </a>

    {!isApp && (
      <header 
        id="main-header" 
        data-transparent={transparentNavOnLoad ? "true" : "false"} 
        class={`sticky top-0 z-40 transition-all duration-500 ease-out flex justify-center ${
          transparentNavOnLoad ? "w-full -mb-16 bg-transparent" : "w-full nav-glass"
        }`}
      >
        <nav 
          id="main-nav-inner"
          class={`transition-all duration-500 ease-out flex items-center justify-between ${
            transparentNavOnLoad ? "w-full container mx-auto px-6 h-16" : "w-full container mx-auto px-6 h-16"
          }`} 
          aria-label="Global Navigation"
        >
          <!-- Logo & Brand -->
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-2.5 outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-md py-1" aria-label="CivicConnect Home">
              <img src="/logo.png" alt="CivicConnect Logo" class="w-7 h-7 object-contain drop-shadow-sm" />
              <span class="font-medium text-[15px] tracking-tight text-foreground">
                CivicConnect
              </span>
            </a>
          </div>

          <!-- Desktop Navigation Menu -->
          <div class="hidden md:flex items-center gap-1">
            <a href="/how-it-works" class="nav-link" aria-current={pathname === '/how-it-works' ? 'page' : undefined}>How It Works</a>
            <a href="/welfare-schemes" class="nav-link" aria-current={pathname === '/welfare-schemes' ? 'page' : undefined}>Welfare Schemes</a>
            <a href="/legal-info" class="nav-link" aria-current={pathname === '/legal-info' ? 'page' : undefined}>Laws & Acts</a>
            <a href="/sources-methodology" class="nav-link" aria-current={pathname === '/sources-methodology' ? 'page' : undefined}>Methodology</a>
            <a href="/about" class="nav-link" aria-current={pathname === '/about' ? 'page' : undefined}>About</a>
            <a href="/faq" class="nav-link" aria-current={pathname === '/faq' ? 'page' : undefined}>FAQ</a>
            <a href="/contact" class="nav-link" aria-current={pathname === '/contact' ? 'page' : undefined}>Contact</a>
          </div>

          <!-- Launch CTA & Shortkey -->
          <div class="hidden md:flex items-center gap-3">
            <a href="/assistant" class="btn btn-primary btn-sm" aria-label="Open CivicConnect AI Assistant">
              <span>Open Assistant</span>
              <kbd class="hidden lg:inline-flex items-center px-1.5 py-0.5 text-[10px] rounded bg-white/20 text-white font-mono leading-none">⌘K</kbd>
            </a>
          </div>

          <!-- Mobile Hamburger Toggle Button -->
          <button 
            type="button" 
            id="mobile-nav-toggle"
            class="md:hidden flex items-center justify-center w-9 h-9 text-muted-foreground hover:text-foreground rounded-md transition-colors" 
            aria-controls="mobile-menu" 
            aria-expanded="false"
            aria-label="Toggle Navigation Menu"
          >
            <svg class="w-5 h-5" id="menu-icon-hamburger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="w-5 h-5 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </nav>

        <!-- Mobile Navigation Dropdown -->
        <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 right-0 border-t border-border bg-card px-6 py-4 flex flex-col gap-2 shadow-md">
          <a href="/how-it-works" class="nav-link w-full py-2" aria-current={pathname === '/how-it-works' ? 'page' : undefined}>How It Works</a>
          <a href="/welfare-schemes" class="nav-link w-full py-2" aria-current={pathname === '/welfare-schemes' ? 'page' : undefined}>Welfare Schemes</a>
          <a href="/legal-info" class="nav-link w-full py-2" aria-current={pathname === '/legal-info' ? 'page' : undefined}>Laws & Acts</a>
          <a href="/sources-methodology" class="nav-link w-full py-2" aria-current={pathname === '/sources-methodology' ? 'page' : undefined}>Methodology</a>
          <a href="/about" class="nav-link w-full py-2" aria-current={pathname === '/about' ? 'page' : undefined}>About</a>
          <a href="/faq" class="nav-link w-full py-2" aria-current={pathname === '/faq' ? 'page' : undefined}>FAQ</a>
          <a href="/contact" class="nav-link w-full py-2" aria-current={pathname === '/contact' ? 'page' : undefined}>Contact</a>
          <a href="/assistant" class="btn btn-primary w-full mt-2">
            Open Assistant
          </a>
        </div>
      </header>
    )}

    <!-- Main Page Content -->
    <main id="main-content" class="flex-grow focus:outline-none">
      <slot />
    </main>

    {!isApp && (
      <footer class="border-t border-border bg-muted py-16 px-6 mt-24">
        <div class="container mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
          <!-- Col 1: Brand & Disclaimer summary -->
          <div class="md:col-span-2 flex flex-col gap-4">
            <div class="flex items-center gap-2.5">
              <img src="/logo.png" alt="CivicConnect Logo" class="w-6 h-6 object-contain" />
              <span class="font-medium text-sm tracking-tight text-foreground">CivicConnect</span>
            </div>
            <p class="text-sm text-muted-foreground max-w-sm leading-relaxed">
              An AI-powered civic information platform designed to make Indian laws and welfare benefits transparent and easily accessible for all citizens.
            </p>
            <p class="text-xs text-muted-foreground/80 leading-relaxed max-w-lg">
              Disclaimer: CivicConnect provides informational summaries based on official government documentation. It is not a legislative authority, does not offer professional legal counsel, and answers should be verified against official Gazettes.
            </p>
          </div>

          <!-- Col 2: Directory links -->
          <div class="flex flex-col gap-3">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Directories</span>
            <a href="/welfare-schemes" class="text-sm text-foreground hover:text-muted-foreground transition-colors">Welfare Schemes</a>
            <a href="/legal-info" class="text-sm text-foreground hover:text-muted-foreground transition-colors">Indian Laws & Acts</a>
            <a href="/sources-methodology" class="text-sm text-foreground hover:text-muted-foreground transition-colors">Data Methodology</a>
          </div>

          <!-- Col 3: Legal Policy links -->
          <div class="flex flex-col gap-3">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Legal & Safety</span>
            <a href="/disclaimer" class="text-sm text-foreground hover:text-muted-foreground transition-colors">Official Disclaimer</a>
            <a href="/privacy" class="text-sm text-foreground hover:text-muted-foreground transition-colors">Privacy Policy</a>
            <a href="/terms" class="text-sm text-foreground hover:text-muted-foreground transition-colors">Terms of Service</a>
          </div>
        </div>

        <div class="container mx-auto border-t border-border mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
          <span>© {new Date().getFullYear()} CivicConnect. Public civic initiative.</span>
          <span>Verified source documentation.</span>
        </div>
      </footer>
    )}

    <!-- Mobile Navigation Toggle Script -->
    <script>
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconHamburger = document.getElementById('menu-icon-hamburger');
      const iconClose = document.getElementById('menu-icon-close');

      if (toggleBtn && mobileMenu && iconHamburger && iconClose) {
        toggleBtn.addEventListener('click', () => {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
          mobileMenu.classList.toggle('hidden');
          iconHamburger.classList.toggle('hidden');
          iconClose.classList.toggle('hidden');
        });
      }

      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          window.location.href = '/assistant';
        }
      });
    
      // Navbar smooth conversion into Floating Pill Navbar on scroll
      const mainHeader = document.getElementById('main-header');
      const mainNavInner = document.getElementById('main-nav-inner');
      if (mainHeader && mainHeader.getAttribute('data-transparent') === 'true' && mainNavInner) {
        const updateHeaderOnScroll = () => {
          // When user scrolls and white background emerges (> 180px)
          if (window.scrollY > 180) {
            // Pill Navbar Floating Mode
            mainHeader.classList.add('pt-3', 'pointer-events-none');
            mainNavInner.classList.remove('container', 'w-full', 'px-6', 'h-16');
            mainNavInner.classList.add(
              'pointer-events-auto',
              'max-w-5xl',
              'w-[92%]',
              'h-13',
              'px-5',
              'rounded-full',
              'bg-white/85',
              'backdrop-blur-xl',
              'shadow-lg',
              'shadow-black/5'
            );
          } else {
            // Full Width Transparent Hero Mode
            mainHeader.classList.remove('pt-3', 'pointer-events-none');
            mainNavInner.classList.remove(
              'pointer-events-auto',
              'max-w-5xl',
              'w-[92%]',
              'h-13',
              'px-5',
              'rounded-full',
              'bg-white/85',
              'backdrop-blur-xl',
              'shadow-lg',
              'shadow-black/5'
            );
            mainNavInner.classList.add('container', 'w-full', 'px-6', 'h-16');
          }
        };
        window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
        updateHeaderOnScroll();
      }
    </script>
  </body>
</html>
