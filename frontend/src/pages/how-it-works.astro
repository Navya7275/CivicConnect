---
import Layout from '../layouts/Layout.astro';
---

<Layout title="How It Works | CivicConnect" description="Understand the technology and verified pipeline behind CivicConnect's answers.">
  <div class="container section max-w-4xl">
    <!-- Header -->
    <div class="mb-14 max-w-3xl">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-foreground leading-[1.15] mb-4">
        How CivicConnect Works. Constrained RAG pipeline.
      </h1>
      <p class="text-base text-muted-foreground leading-relaxed">
        A structured, reliable system designed to verify every single generated answer against official statutory acts and government schemes.
      </p>
    </div>

    <!-- Timeline Steps -->
    <div class="space-y-8 relative">
      
      <!-- Step 1 -->
      <article class="card flex flex-col md:flex-row gap-6 items-start">
        <div class="w-10 h-10 rounded-ui-full bg-primary text-primary-foreground font-mono text-sm font-semibold flex items-center justify-center shrink-0">
          01
        </div>
        <div class="space-y-2">
          <span class="badge badge-soft" data-tone="primary">Citizen Input</span>
          <h2 class="text-h3 text-xl">Ask in Plain Language</h2>
          <p class="text-small text-muted-foreground leading-relaxed">
            Type your query into the assistant composer just like you would describe a problem to a friend. For example: <em>"How do I register a birth in Maharashtra?"</em> or <em>"What is the landholding limit for the PM-Kisan scheme?"</em>
          </p>
        </div>
      </article>

      <!-- Step 2 -->
      <article class="card flex flex-col md:flex-row gap-6 items-start">
        <div class="w-10 h-10 rounded-ui-full bg-primary text-primary-foreground font-mono text-sm font-semibold flex items-center justify-center shrink-0">
          02
        </div>
        <div class="space-y-2">
          <span class="badge badge-soft" data-tone="accent">Hybrid Search</span>
          <h2 class="text-h3 text-xl">Retrieve Verified Source Documents</h2>
          <p class="text-small text-muted-foreground leading-relaxed">
            The system searches indexed, official documents matching your selected jurisdiction (Central or State). It retrieves the exact sections of relevant legislation, official rules, or scheme manuals using dense vector search and BM25 lexical ranking.
          </p>
        </div>
      </article>

      <!-- Step 3 -->
      <article class="card flex flex-col md:flex-row gap-6 items-start">
        <div class="w-10 h-10 rounded-ui-full bg-primary text-primary-foreground font-mono text-sm font-semibold flex items-center justify-center shrink-0">
          03
        </div>
        <div class="space-y-2">
          <span class="badge badge-soft" data-tone="warning">Closed-Domain Synthesis</span>
          <h2 class="text-h3 text-xl">Generate Context-Bound Explanations</h2>
          <p class="text-small text-muted-foreground leading-relaxed">
            An AI assistant reads the retrieved source documents and draft-generates a clear, simplified summary response. The model is constrained to write <em>only</em> what is supported by the facts in the retrieved documents, preventing common AI hallucinations.
          </p>
        </div>
      </article>

      <!-- Step 4 -->
      <article class="card flex flex-col md:flex-row gap-6 items-start">
        <div class="w-10 h-10 rounded-ui-full bg-primary text-primary-foreground font-mono text-sm font-semibold flex items-center justify-center shrink-0">
          04
        </div>
        <div class="space-y-2">
          <span class="badge badge-soft" data-tone="success">Verification Check</span>
          <h2 class="text-h3 text-xl">Statutory Citations & Cross-Referencing</h2>
          <p class="text-small text-muted-foreground leading-relaxed">
            The final answer is presented alongside interactive citation pills naming the exact Act and Section relied upon, allowing citizens to inspect the statutory text directly or click through to original Gazette records.
          </p>
        </div>
      </article>

    </div>

    <!-- Final Callout -->
    <div class="mt-16 card bg-muted/40 text-center space-y-4">
      <h3 class="text-h3 text-lg">Experience the pipeline in action</h3>
      <p class="text-small text-muted-foreground max-w-md mx-auto">
        Test our retrieval-augmented generation engine with queries across Indian welfare programs and criminal law reforms.
      </p>
      <div class="pt-2">
        <a href="/assistant" class="btn btn-primary btn-sm">
          Try CivicConnect Assistant
        </a>
      </div>
    </div>
  </div>
</Layout>
