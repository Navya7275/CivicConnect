---
import Layout from '../layouts/Layout.astro';
import LegalInfoBrowser from '../components/LegalInfoBrowser';
---

<Layout title="Indian Laws & Acts Directory | CivicConnect" description="Search and browse legal sections of Indian civil legislation and criminal reform codes.">
  <div class="container section">
    <!-- Header -->
    <div class="mb-12 max-w-3xl">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-foreground leading-[1.15] mb-4">
        Statutory Laws & Acts. Indexed down to individual sections.
      </h1>
      <p class="text-base text-muted-foreground leading-relaxed">
        Access cataloged chapters, search specific penal and civil sections, and explore original statutory text with context-specific query options.
      </p>
    </div>

    <!-- Interactive React Component -->
    <LegalInfoBrowser client:load />
  </div>
</Layout>
