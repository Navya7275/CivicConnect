---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | CivicConnect" description="Get in touch with the CivicConnect team for questions, suggestions, or feedback.">
  <div class="container section max-w-lg">
    <!-- Header -->
    <div class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-foreground leading-[1.15] mb-3">
        Get in touch. We welcome your feedback.
      </h1>
      <p class="text-base text-muted-foreground leading-relaxed max-w-md mx-auto">
        Have questions, suggestions, or reports about citizen rights and statutory data? Send us a message.
      </p>
    </div>

    <!-- Success message overlay -->
    <div id="success-banner" class="hidden card !p-6 text-center mb-8 border-success space-y-3" aria-live="polite">
      <div class="w-10 h-10 rounded-ui-full bg-success/10 text-success mx-auto flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth="2"><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h2 class="text-h3 text-lg">Message Submitted</h2>
      <p class="text-small text-muted-foreground">Thank you for reaching out. Our team will review your message shortly.</p>
      <button type="button" id="reset-form-btn" class="btn btn-secondary btn-sm">Send Another Message</button>
    </div>

    <!-- Contact Form -->
    <form id="contact-form" class="card space-y-5" novalidate>
      <!-- Name field -->
      <div class="space-y-1.5">
        <label for="user-name" class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Your Name</label>
        <input 
          type="text" 
          id="user-name" 
          name="name" 
          placeholder="e.g. Aditi Sharma" 
          required 
          autocomplete="name" 
          class="input"
        />
        <span id="name-error" class="hidden text-xs text-destructive mt-1" role="alert">Please enter your name.</span>
      </div>

      <!-- Email field -->
      <div class="space-y-1.5">
        <label for="user-email" class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Email Address</label>
        <input 
          type="email" 
          id="user-email" 
          name="email" 
          placeholder="name@example.com" 
          required 
          autocomplete="email" 
          spellcheck="false"
          class="input"
        />
        <span id="email-error" class="hidden text-xs text-destructive mt-1" role="alert">Please enter a valid email address.</span>
      </div>

      <!-- Message field -->
      <div class="space-y-1.5">
        <label for="user-message" class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Your Message</label>
        <textarea 
          id="user-message" 
          name="message" 
          rows="5" 
          placeholder="Describe your inquiry, suggestion, or correction…" 
          required 
          class="input"
        ></textarea>
        <span id="message-error" class="hidden text-xs text-destructive mt-1" role="alert">Please enter your message (at least 10 characters).</span>
      </div>

      <!-- Submit button -->
      <button 
        type="submit" 
        id="submit-btn" 
        class="btn btn-primary w-full"
      >
        <span id="btn-text">Submit Message</span>
        <svg id="btn-spinner" class="hidden animate-spin h-4 w-4 ml-2 text-primary-foreground" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </button>
    </form>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const nameInput = document.getElementById('user-name') as HTMLInputElement;
    const emailInput = document.getElementById('user-email') as HTMLInputElement;
    const messageInput = document.getElementById('user-message') as HTMLTextAreaElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const successBanner = document.getElementById('success-banner');
    const resetBtn = document.getElementById('reset-form-btn');

    const nameError = document.getElementById('name-error');
    const emailError = document.getElementById('email-error');
    const messageError = document.getElementById('message-error');

    function validateEmail(email: string) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        let isValid = true;

        if (!nameInput.value.trim()) {
          nameError?.classList.remove('hidden');
          nameInput.setAttribute('aria-invalid', 'true');
          isValid = false;
        } else {
          nameError?.classList.add('hidden');
          nameInput.removeAttribute('aria-invalid');
        }

        if (!emailInput.value.trim() || !validateEmail(emailInput.value.trim())) {
          emailError?.classList.remove('hidden');
          emailInput.setAttribute('aria-invalid', 'true');
          isValid = false;
        } else {
          emailError?.classList.add('hidden');
          emailInput.removeAttribute('aria-invalid');
        }

        if (!messageInput.value.trim() || messageInput.value.trim().length < 10) {
          messageError?.classList.remove('hidden');
          messageInput.setAttribute('aria-invalid', 'true');
          isValid = false;
        } else {
          messageError?.classList.add('hidden');
          messageInput.removeAttribute('aria-invalid');
        }

        if (!isValid) return;

        submitBtn.disabled = true;
        btnText?.classList.add('hidden');
        btnSpinner?.classList.remove('hidden');

        await new Promise(resolve => setTimeout(resolve, 800));

        submitBtn.disabled = false;
        btnText?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
        form.classList.add('hidden');
        successBanner?.classList.remove('hidden');
        form.reset();
      });

      resetBtn?.addEventListener('click', () => {
        successBanner?.classList.add('hidden');
        form.classList.remove('hidden');
      });
    }
  </script>
</Layout>
