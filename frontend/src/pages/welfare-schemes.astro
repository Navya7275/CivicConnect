---
import Layout from '../layouts/Layout.astro';
import WelfareSchemesBrowser from '../components/WelfareSchemesBrowser';
---

<Layout title="Government Welfare Schemes Directory | CivicConnect" description="Search and discover Indian central and state welfare benefits, pensions, and healthcare aids.">
  <div class="container section">
    <!-- Header -->
    <div class="mb-12 max-w-3xl">
      <span class="badge badge-soft mb-3" data-tone="accent">Citizen Benefits Directory</span>
      <h1 class="text-h1 mb-4">
        Government Welfare Schemes. <span class="text-muted-foreground">Verified eligibility criteria.</span>
      </h1>
      <p class="text-body text-muted-foreground leading-relaxed">
        Filter through central and state-specific programs to check eligibility specifications, claim criteria, and document requirements.
      </p>
    </div>

    <!-- Interactive React Component -->
    <WelfareSchemesBrowser client:load />
  </div>
</Layout>
