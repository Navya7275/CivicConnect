---
import Layout from '../layouts/Layout.astro';
import GradientASCII from '../components/ui/GradientASCII';
---

<Layout title="CivicConnect | Indian Law & Welfare Schemes Assistant" transparentNavOnLoad={true}>
  <!-- Atmospheric Hero Wrapper with natural scrolling GradientASCII background -->
  <div class="relative overflow-visible">
    <!-- GradientASCII Canvas attached to document flow so it stays prominent and only merges just before feature animation -->
    <div 
      id="hero-gradient-bg" 
      class="absolute top-0 left-0 right-0 h-[850px] md:h-[1850px] pointer-events-none overflow-hidden z-0 transition-opacity duration-300"
      style="mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 70%, rgba(0,0,0,0.5) 88%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 70%, rgba(0,0,0,0.5) 88%, rgba(0,0,0,0) 100%);"
    >
      <GradientASCII 
        client:load 
        colors={['#1e3fd8', '#4f46e5', '#38bdf8', '#818cf8', '#e0e7ff']}
        shape="horizon"
        characters=" =+xX0S8#@"
        cellSize={18}
        density={0.75}
        gradientOpacity={0.65}
        glyphOpacity={0.85}
        lightMode={true}
        mouseInteraction={true}
      />
    </div>

    <!-- Modern High-Impact Hero Section (OpenAI/Apple Minimalist Style) -->
    <section id="hero-gradient-wrapper" class="relative pt-24 pb-8 md:pt-32 md:pb-12 bg-transparent z-10">
    <!-- ChatGPT-style organic asterisk decorative elements scattered across the hero canvas -->
    <!-- 1. Bottom-Left Medium Asterisk -->
    <div class="absolute left-6 md:left-16 bottom-20 select-none pointer-events-none opacity-20 text-foreground" aria-hidden="true">
      <svg class="w-14 h-14 md:w-16 md:h-16 transform -rotate-12" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round">
        <line x1="50" y1="12" x2="50" y2="88" />
        <line x1="17" y1="31" x2="83" y2="69" />
        <line x1="17" y1="69" x2="83" y2="31" />
      </svg>
    </div>

    <!-- 2. Top-Right Large Asterisk -->
    <div class="absolute right-6 md:right-20 top-16 select-none pointer-events-none opacity-25 text-foreground" aria-hidden="true">
      <svg class="w-16 h-16 md:w-20 md:h-20 transform rotate-12" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round">
        <line x1="50" y1="10" x2="50" y2="90" />
        <line x1="15" y1="30" x2="85" y2="70" />
        <line x1="15" y1="70" x2="85" y2="30" />
      </svg>
    </div>

    <!-- 3. Mid-Left Small Delicate Asterisk -->
    <div class="absolute left-10 md:left-28 top-28 select-none pointer-events-none opacity-15 text-foreground hidden sm:block" aria-hidden="true">
      <svg class="w-8 h-8 md:w-10 md:h-10 transform rotate-45" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round">
        <line x1="50" y1="12" x2="50" y2="88" />
        <line x1="17" y1="31" x2="83" y2="69" />
        <line x1="17" y1="69" x2="83" y2="31" />
      </svg>
    </div>

    <!-- 4. Lower-Right Medium Asterisk -->
    <div class="absolute right-12 md:right-32 bottom-12 select-none pointer-events-none opacity-20 text-foreground" aria-hidden="true">
      <svg class="w-12 h-12 md:w-14 md:h-14 transform -rotate-20" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round">
        <line x1="50" y1="10" x2="50" y2="90" />
        <line x1="15" y1="30" x2="85" y2="70" />
        <line x1="15" y1="70" x2="85" y2="30" />
      </svg>
    </div>

    <!-- 5. Top-Center Soft Small Star Accent -->
    <div class="absolute left-[38%] top-10 select-none pointer-events-none opacity-10 text-foreground hidden lg:block" aria-hidden="true">
      <svg class="w-7 h-7 transform rotate-15" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round">
        <line x1="50" y1="12" x2="50" y2="88" />
        <line x1="17" y1="31" x2="83" y2="69" />
        <line x1="17" y1="69" x2="83" y2="31" />
      </svg>
    </div>

    <div class="container max-w-5xl mx-auto px-6 text-center flex flex-col items-center relative z-10">
      
      <!-- Massive Hero Headline with Multi-Color Underline Accent (Matching OpenAI/ChatGPT style on key keyword) -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-[84px] font-medium tracking-tight text-foreground leading-[1.06] max-w-4xl mb-8">
        Ask real questions.<br class="hidden sm:inline" />
        <span class="inline-block">Get plain answers.</span><br />
        <span class="inline-block">
          Verified by <span class="relative inline-block">law.<span 
            class="absolute -bottom-1.5 left-0 right-0 h-1 rounded-full shadow-sm" 
            style="background: linear-gradient(to right, #e11d48 0%, #ea580c 20%, #eab308 40%, #16a34a 60%, #0284c7 80%, #9333ea 100%);"
            aria-hidden="true"
          ></span></span>
        </span>
      </h1>

      <!-- CTA Buttons Row -->
      <div class="flex flex-wrap items-center justify-center gap-4 mt-6 mb-4">
        <a 
          href="/assistant" 
          class="btn btn-primary !h-12 !px-8 text-base font-medium shadow-md hover:shadow-lg transition-all rounded-full"
        >
          Try it now ↗
        </a>
        <a 
          href="/how-it-works" 
          class="inline-flex items-center gap-2 text-base font-medium text-foreground bg-white/90 hover:bg-white border border-black/10 hover:border-black/20 shadow-md hover:shadow-lg transition-all rounded-full !h-12 !px-7 backdrop-blur-sm"
        >
          <span>Explore how it works</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth="2"><path strokeLinecap="round" strokeLinejoin="round" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </div>

    </div>
    </section>
  </div>

  <!-- ChatGPT-Style Sticky Scrollytelling Section -->
  <section class="relative bg-transparent -mt-4 md:-mt-6" id="showcase-scrollytelling">
    
    <!-- Stage Container with total scroll runway -->
    <div class="relative min-h-[350vh] md:min-h-[500vh]" id="scrolly-runway">
      
      <!-- Sticky Frame pinned to viewport -->
      <div class="sticky top-0 h-screen flex items-center overflow-hidden">
        <div class="container max-w-7xl mx-auto px-4 md:px-6 w-full">
          
          <div class="relative flex flex-col lg:flex-row items-center justify-between w-full min-h-[480px] lg:min-h-[520px] gap-6 lg:gap-0">
            
            <!-- Left Side (or Below Mockup on mobile): Feature Tab Menu -->
            <div 
              id="scrolly-features-col" 
              class="w-full lg:w-[34%] flex flex-col gap-5 sm:gap-6 lg:gap-8 transition-all duration-700 ease-out z-10 order-2 lg:order-1"
              style="opacity: 1; pointer-events: auto;"
            >
              <!-- Step 1: Chat -->
              <div class="scrolly-step group cursor-pointer transition-all duration-300" data-step="0">
                <div class="pt-1 sm:pt-2 mb-1 sm:mb-2">
                  <h2 class="step-title text-xl sm:text-2xl lg:text-3xl font-medium tracking-tight text-foreground transition-all duration-300">
                    Chat
                  </h2>
                  <!-- Dynamic Progress Line Track -->
                  <div class="step-track relative w-full h-[2px] bg-border/70 mt-2 sm:mt-3.5 overflow-hidden rounded-full">
                    <div class="step-bar absolute left-0 top-0 bottom-0 bg-foreground origin-left rounded-full transition-transform duration-75 ease-out" style="transform: scaleX(0.08); width: 100%;"></div>
                  </div>
                </div>
                
                <div class="step-content space-y-1 sm:space-y-3 pt-1 sm:pt-2 transition-all duration-300">
                  <p class="text-xs sm:text-sm lg:text-base font-medium text-foreground">
                    For questions, legal rights, and everyday civic help.
                  </p>
                  <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-2 sm:line-clamp-none">
                    Get help with everyday questions on civic laws, explaining court procedures, checking road penalties, drafting RTI requests, or knowing which government portal to visit.
                  </p>
                </div>
              </div>

              <!-- Step 2: Grounded Citations -->
              <div class="scrolly-step group cursor-pointer transition-all duration-300" data-step="1">
                <div class="pt-1 sm:pt-2 mb-1 sm:mb-2">
                  <h2 class="step-title text-xl sm:text-2xl lg:text-3xl font-medium tracking-tight text-muted-foreground transition-all duration-300">
                    Verify
                  </h2>
                  <!-- Dynamic Progress Line Track -->
                  <div class="step-track relative w-full h-[2px] bg-border/70 mt-2 sm:mt-3.5 overflow-hidden rounded-full">
                    <div class="step-bar absolute left-0 top-0 bottom-0 bg-foreground origin-left rounded-full transition-transform duration-75 ease-out" style="transform: scaleX(0.08); width: 100%;"></div>
                  </div>
                </div>
                
                <div class="step-content space-y-1 sm:space-y-3 pt-1 sm:pt-2 transition-all duration-300 opacity-0 max-h-0 overflow-hidden pointer-events-none">
                  <p class="text-xs sm:text-sm lg:text-base font-medium text-foreground">
                    For verified legal provisions backed by official gazettes.
                  </p>
                  <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-2 sm:line-clamp-none">
                    Every sentence is cross-checked against retrieved statutory sections from the Bharatiya Nyaya Sanhita 2023, Motor Vehicles Act 1988, or official scheme guidelines with zero hallucination.
                  </p>
                </div>
              </div>

              <!-- Step 3: Welfare Schemes Catalog -->
              <div class="scrolly-step group cursor-pointer transition-all duration-300" data-step="2">
                <div class="pt-1 sm:pt-2 mb-1 sm:mb-2">
                  <h2 class="step-title text-xl sm:text-2xl lg:text-3xl font-medium tracking-tight text-muted-foreground transition-all duration-300">
                    Schemes
                  </h2>
                  <!-- Dynamic Progress Line Track -->
                  <div class="step-track relative w-full h-[2px] bg-border/70 mt-2 sm:mt-3.5 overflow-hidden rounded-full">
                    <div class="step-bar absolute left-0 top-0 bottom-0 bg-foreground origin-left rounded-full transition-transform duration-75 ease-out" style="transform: scaleX(0.08); width: 100%;"></div>
                  </div>
                </div>
                
                <div class="step-content space-y-1 sm:space-y-3 pt-1 sm:pt-2 transition-all duration-300 opacity-0 max-h-0 overflow-hidden pointer-events-none">
                  <p class="text-xs sm:text-sm lg:text-base font-medium text-foreground">
                    For government aid, eligibility checklists, and direct benefits.
                  </p>
                  <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-2 sm:line-clamp-none">
                    Explore cataloged state and central programs—including Ayushman Bharat PM-JAY, PM-Kisan farm aid, and PMJDY financial inclusion—with exact document checklists and transfer details.
                  </p>
                </div>
              </div>
            </div>

            <!-- Right Side (or Top on mobile): App Window Mockup -->
            <div 
              id="scrolly-mockup-wrapper"
              class="w-full lg:w-[62%] rounded-xl sm:rounded-ui-xl bg-card border border-border shadow-xl lg:shadow-2xl overflow-hidden text-left transition-all duration-500 ease-out order-1 lg:order-2"
              style="transform: scale(0.95); opacity: 1;"
            >
              <!-- Window Titlebar with Traffic Lights -->
              <div class="h-8 sm:h-11 px-3 sm:px-4 bg-muted/60 flex items-center relative select-none">
                <!-- Left: Traffic light circles -->
                <div class="flex items-center gap-1.5 sm:gap-2 z-10">
                  <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ff5f57] border border-[#e0443e]"></span>
                  <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#febc2e] border border-[#d89e24]"></span>
                  <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#28c840] border border-[#1aab29]"></span>
                </div>

                <!-- Center only: CivicConnect brand title -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <span class="text-[11px] sm:text-xs font-medium text-foreground tracking-tight">
                    CivicConnect
                  </span>
                </div>
              </div>

              <!-- Image Stage with Sliding / Crossfade Screens -->
              <div class="relative w-full aspect-[16/10] sm:aspect-[1024/495] bg-card overflow-hidden">
                <img 
                  id="showcase-img-0"
                  src="/showcase/stage-welcome.png" 
                  alt="CivicConnect Welcome Assistant Interface" 
                  class="showcase-slide absolute inset-0 w-full h-full object-contain transition-opacity duration-500 opacity-100"
                />
                <img 
                  id="showcase-img-1"
                  src="/showcase/stage-chat.png" 
                  alt="CivicConnect Live Chat Turn with Citations" 
                  class="showcase-slide absolute inset-0 w-full h-full object-contain transition-opacity duration-500 opacity-0"
                />
                <img 
                  id="showcase-img-2"
                  src="/showcase/stage-schemes.png" 
                  alt="CivicConnect Welfare Schemes Directory" 
                  class="showcase-slide absolute inset-0 w-full h-full object-contain transition-opacity duration-500 opacity-0"
                />
              </div>

            </div>

          </div>

        </div>
      </div>

    </div>
  </section>

  <script>
    // Continuous 2-Phase ChatGPT-Style Scrollytelling:
    // Phase 1 (Scroll 0 -> 25%): Screenshot starts dead CENTER. As user scrolls down, hero scrolls away while screenshot pins and smoothly slides rightward, while the feature tabs slide in from the left.
    // Phase 2 (Scroll 25% -> 100%): Left features switch between Chat -> Verify -> Schemes, and the right screenshot switches in lockstep.
    document.addEventListener('DOMContentLoaded', () => {
      const runway = document.getElementById('scrolly-runway');
      const mockup = document.getElementById('scrolly-mockup-wrapper');
      const featuresCol = document.getElementById('scrolly-features-col');
      const steps = document.querySelectorAll('.scrolly-step');
      const slides = document.querySelectorAll('.showcase-slide');

      if (!runway || !mockup || !featuresCol) return;

      let currentActiveIndex = 0;

      const activateStep = (index: number) => {
        if (currentActiveIndex === index) return;
        currentActiveIndex = index;

        steps.forEach((s, idx) => {
          const title = s.querySelector('.step-title');
          const content = s.querySelector('.step-content');

          if (idx === index) {
            title?.classList.remove('text-muted-foreground');
            title?.classList.add('text-foreground');
            content?.classList.remove('opacity-0', 'max-h-0', 'pointer-events-none');
            content?.classList.add('opacity-100', 'max-h-96');
          } else {
            title?.classList.remove('text-foreground');
            title?.classList.add('text-muted-foreground');
            content?.classList.remove('opacity-100', 'max-h-96');
            content?.classList.add('opacity-0', 'max-h-0', 'pointer-events-none');
          }
        });

        slides.forEach((slide, idx) => {
          if (idx === index) {
            slide.classList.remove('opacity-0');
            slide.classList.add('opacity-100');
          } else {
            slide.classList.remove('opacity-100');
            slide.classList.add('opacity-0');
          }
        });
      };

      const heroGradientBg = document.getElementById('hero-gradient-bg');

      const handleScroll = () => {
        if (window.innerWidth < 1024) return;
        const rect = runway.getBoundingClientRect();
        const totalScrollable = runway.offsetHeight - window.innerHeight;
        if (totalScrollable <= 0) return;

        // Overall progress through the entire scrollytelling runway (0 to 1)
        const progress = Math.max(0, Math.min(1, -rect.top / totalScrollable));

        // The atmospheric background stays rich and fully visible while screenshot is centered!
        // It merges into white smoothly right as the screenshot begins shifting to the right (progress 0.20 -> 0.38)
        if (heroGradientBg) {
          if (progress <= 0.20) {
            heroGradientBg.style.opacity = '1';
          } else {
            const fade = Math.min(1, (progress - 0.20) / 0.18);
            heroGradientBg.style.opacity = (1 - fade).toFixed(3);
          }
        }

        if (window.innerWidth >= 1024) {
          // Desktop Sequence:
          let slideProgress = 0;
          if (progress <= 0.24) {
            slideProgress = 0;
          } else {
            slideProgress = Math.min(1, (progress - 0.24) / 0.22);
          }

          const currentOffset = -28 * (1 - slideProgress);
          const currentScale = 1.15 - (0.15 * slideProgress);
          const currentTranslateY = 12 * (1 - slideProgress);

          mockup.style.transform = `translateX(${currentOffset.toFixed(2)}%) translateY(${currentTranslateY.toFixed(1)}px) scale(${currentScale.toFixed(3)})`;
          featuresCol.style.opacity = slideProgress.toFixed(2);
          featuresCol.style.transform = `translateX(${(-40 * (1 - slideProgress)).toFixed(1)}px)`;
          featuresCol.style.pointerEvents = slideProgress > 0.8 ? 'auto' : 'none';
        } else {
          // Mobile & Tablet: Features and Mockup are naturally stacked and always 100% visible
          mockup.style.transform = 'scale(0.98)';
          featuresCol.style.opacity = '1';
          featuresCol.style.transform = 'none';
          featuresCol.style.pointerEvents = 'auto';
        }

        // --- Phase 2: Generous Feature Dwell Duration & Progress Scaling ---
        // Step 0 (Chat) Range: 0.20 -> 0.48
        // Step 1 (Verify) Range: 0.48 -> 0.74
        // Step 2 (Schemes) Range: 0.74 -> 1.00
        const stepRanges = [
          { start: 0.20, end: 0.48 },
          { start: 0.48, end: 0.74 },
          { start: 0.74, end: 1.00 }
        ];

        steps.forEach((s, idx) => {
          const bar = s.querySelector('.step-bar') as HTMLElement | null;
          if (!bar) return;

          const range = stepRanges[idx];
          if (progress < range.start) {
            // Unreached: small indicator line (8% width)
            bar.style.transform = 'scaleX(0.08)';
            bar.style.opacity = '0.35';
          } else if (progress >= range.end) {
            // Completed: full line (100% width)
            bar.style.transform = 'scaleX(1.0)';
            bar.style.opacity = '1.0';
          } else {
            // Currently active & filling: smoothly scale from 0.08 to 1.0
            const stepProgress = (progress - range.start) / (range.end - range.start);
            const scale = 0.08 + (0.92 * stepProgress);
            bar.style.transform = `scaleX(${scale.toFixed(3)})`;
            bar.style.opacity = '1.0';
          }
        });

        if (progress < 0.48) {
          activateStep(0);
        } else if (progress < 0.74) {
          activateStep(1);
        } else {
          activateStep(2);
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('resize', handleScroll, { passive: true });
      handleScroll();

      // Click tab to jump to its corresponding scroll position
      steps.forEach((step, idx) => {
        step.addEventListener('click', () => {
          const totalScrollable = runway.offsetHeight - window.innerHeight;
          const targetProgress = 0.25 + (idx * 0.35);
          const targetY = runway.offsetTop + (targetProgress * totalScrollable);
          window.scrollTo({ top: targetY, behavior: 'smooth' });
        });
      });
    });
  </script>
  <!-- Domain Cards: Vertical Stack Spreading from Center on Scroll -->
  <section class="py-24 border-b border-border bg-[#ececf0]/70 relative overflow-hidden" id="explore-cards-section">
    <div class="container max-w-6xl">
      <div class="text-center mb-16 space-y-3">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-foreground leading-[1.15] max-w-2xl mx-auto">
          Every provision for work, life, and verified rights.
        </h2>
        <p class="text-base text-muted-foreground max-w-lg mx-auto leading-relaxed">
          Designed for citizens, researchers, and legal aid workers seeking verifiable statutory guidance.
        </p>
      </div>

      <!-- 3 Vertical Cards Container that spreads out horizontally on scroll -->
      <div 
        id="card-spread-container" 
        class="grid grid-cols-1 md:grid-cols-3 gap-6 relative transition-all duration-700 ease-out"
      >
        <!-- Card 1: Statutory Legislation (Left card: shifts from center to left) -->
        <div class="card-spread-item spread-left transition-all duration-700 ease-out">
          <article class="card card-interactive h-full flex flex-col justify-between bg-card border border-border shadow-md !p-8">
            <div class="space-y-5">
              <div class="flex items-center justify-between">
                <span class="badge badge-soft" data-tone="accent">Central & State</span>
                <span class="text-mono text-xs text-muted-foreground">888+ Sections</span>
              </div>
              <h3 class="text-h3 text-xl font-medium">Statutory Legislation</h3>
              <p class="text-small text-muted-foreground leading-relaxed">
                Search Indian civil laws, criminal law reforms such as the Bharatiya Nyaya Sanhita 2023, the Motor Vehicles Act 1988, and RTI provisions in plain vocabulary.
              </p>
            </div>
            <div class="pt-6 border-t border-border mt-6">
              <a href="/legal-info" class="btn btn-secondary btn-sm w-full justify-center">
                Browse Laws & Acts →
              </a>
            </div>
          </article>
        </div>

        <!-- Card 2: Welfare Entitlements (Center card) -->
        <div class="card-spread-item spread-center transition-all duration-700 ease-out z-10">
          <article class="card card-interactive h-full flex flex-col justify-between bg-card border border-border shadow-md !p-8">
            <div class="space-y-5">
              <div class="flex items-center justify-between">
                <span class="badge badge-soft" data-tone="success">Aid & Schemes</span>
                <span class="text-mono text-xs text-muted-foreground">Updated 2026</span>
              </div>
              <h3 class="text-h3 text-xl font-medium">Welfare Entitlements</h3>
              <p class="text-small text-muted-foreground leading-relaxed">
                Discover central and state government programs—including Ayushman Bharat PM-JAY, PM-Kisan farm aid, and pension schemes—with exact checklists and criteria.
              </p>
            </div>
            <div class="pt-6 border-t border-border mt-6">
              <a href="/welfare-schemes" class="btn btn-secondary btn-sm w-full justify-center">
                Browse Schemes →
              </a>
            </div>
          </article>
        </div>

        <!-- Card 3: Grounded AI Verification (Right card: shifts from center to right) -->
        <div class="card-spread-item spread-right transition-all duration-700 ease-out">
          <article class="card card-interactive h-full flex flex-col justify-between bg-card border border-border shadow-md !p-8">
            <div class="space-y-5">
              <div class="flex items-center justify-between">
                <span class="badge badge-soft" data-tone="warning">Zero Hallucination</span>
                <span class="text-mono text-xs text-muted-foreground">RAG Pipeline</span>
              </div>
              <h3 class="text-h3 text-xl font-medium">Verified Citations</h3>
              <p class="text-small text-muted-foreground leading-relaxed">
                Every sentence in an answer is cross-checked against retrieved statutory text. Citations isolate the exact act, section, and official gazette reference.
              </p>
            </div>
            <div class="pt-6 border-t border-border mt-6">
              <a href="/sources-methodology" class="btn btn-secondary btn-sm w-full justify-center">
                Read Methodology →
              </a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Continuous scrubbed scroll: cards spread outward as you scroll down, and smoothly gather/wind up back into the center stack when scrolling up
    document.addEventListener('DOMContentLoaded', () => {
      const section = document.getElementById('explore-cards-section');
      const leftCard = document.querySelector('.card-spread-item.spread-left') as HTMLElement | null;
      const centerCard = document.querySelector('.card-spread-item.spread-center') as HTMLElement | null;
      const rightCard = document.querySelector('.card-spread-item.spread-right') as HTMLElement | null;

      if (!section || !leftCard || !centerCard || !rightCard) return;

      const updateSpread = () => {
        if (window.innerWidth < 768) {
          // On mobile screens, keep standard layout without transforms
          leftCard.style.transform = '';
          leftCard.style.opacity = '1';
          rightCard.style.transform = '';
          rightCard.style.opacity = '1';
          centerCard.style.transform = '';
          return;
        }

        const container = document.getElementById('card-spread-container');
        const cardsRect = container ? container.getBoundingClientRect() : rect;
        const vh = window.innerHeight;

        // Start opening only after the cards container enters into the view (top <= 65% of viewport)
        // Complete the spread when the cards are centered around 20% from top
        const start = vh * 0.65;
        const end = vh * 0.20;
        const rawProgress = (start - cardsRect.top) / (start - end);
        const progress = Math.max(0, Math.min(1, rawProgress));

        // When progress = 0: fully wound up / gathered at center
        // When progress = 1: fully spread in their respective columns
        const leftTranslateX = (1 - progress) * 105; // %
        const rightTranslateX = -(1 - progress) * 105; // %
        const leftRotate = (1 - progress) * -4; // deg
        const rightRotate = (1 - progress) * 4; // deg
        const centerScale = 0.98 + (progress * 0.02);

        leftCard.style.transform = `translateX(${leftTranslateX.toFixed(2)}%) rotate(${leftRotate.toFixed(2)}deg)`;
        leftCard.style.zIndex = progress > 0.8 ? '2' : '1';
        leftCard.style.opacity = (0.75 + progress * 0.25).toFixed(2);

        rightCard.style.transform = `translateX(${rightTranslateX.toFixed(2)}%) rotate(${rightRotate.toFixed(2)}deg)`;
        rightCard.style.zIndex = progress > 0.8 ? '2' : '1';
        rightCard.style.opacity = (0.75 + progress * 0.25).toFixed(2);

        centerCard.style.transform = `scale(${centerScale.toFixed(3)})`;
        centerCard.style.zIndex = '3';
      };

      window.addEventListener('scroll', updateSpread, { passive: true });
      window.addEventListener('resize', updateSpread, { passive: true });
      updateSpread();
    });
  </script>

  <!-- Step-by-Step Methodology Flow -->
