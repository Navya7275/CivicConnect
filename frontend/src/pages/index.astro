  <!-- Scroll-triggered Stagger Animations for Methodology Flow and Final CTA -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Methodology Flow Section Animation (Sequential one-by-one scrubbed scroll)
      const methodSection = document.getElementById('methodology-flow-section');
      const stepHeader = document.querySelector('.step-header-anim') as HTMLElement | null;
      const stepCards = document.querySelectorAll('.step-card-anim');

      if (methodSection && stepHeader && stepCards.length === 4) {
        const updateMethodologyAnim = () => {
          if (window.innerWidth < 768) {
            stepHeader.style.opacity = '1';
            stepHeader.style.transform = '';
            stepCards.forEach(c => {
              (c as HTMLElement).style.opacity = '1';
              (c as HTMLElement).style.transform = '';
            });
            return;
          }

          const vh = window.innerHeight;

          // Animate header only when it enters the lower 75% of viewport
          const headerRect = stepHeader.getBoundingClientRect();
          const headerRawProgress = (vh * 0.75 - headerRect.top) / (vh * 0.35);
          const headerProgress = Math.max(0, Math.min(1, headerRawProgress));
          stepHeader.style.opacity = headerProgress.toFixed(2);
          stepHeader.style.transform = `translateY(${(1 - headerProgress) * 20}px)`;

          // Animate each card individually based on its OWN on-screen position!
          // They only start moving once they are well inside the user's view (top < 70% vh)
          // and reach full alignment when at 35% vh.
          const cardDirs = [-1, 1, -1, 1]; // Left (-1) and Right (1) entrance vectors

          stepCards.forEach((card, idx) => {
            const el = card as HTMLElement;
            const cRect = el.getBoundingClientRect();
            
            // Trigger range: starts at 75% vh (well below viewport top), completes at 40% vh
            const startY = vh * 0.75;
            const endY = vh * 0.40;
            const rawP = (startY - cRect.top) / (startY - endY);
            const p = Math.max(0, Math.min(1, rawP));
            const inv = 1 - p;

            const dir = cardDirs[idx];
            const translateX = inv * (dir * 55); // px
            const translateY = inv * 35; // px
            const rotate = inv * (dir * 2.5); // deg
            const opacity = Math.max(0, p);

            el.style.transform = `translate(${translateX.toFixed(1)}px, ${translateY.toFixed(1)}px) rotate(${rotate.toFixed(1)}deg)`;
            el.style.opacity = opacity.toFixed(2);
          });
        };

        window.addEventListener('scroll', updateMethodologyAnim, { passive: true });
        window.addEventListener('resize', updateMethodologyAnim, { passive: true });
        updateMethodologyAnim();
      }

      // 2. Final CTA Section Animation
      const ctaSection = document.getElementById('final-cta-section');
      const ctaAnim = document.querySelector('.final-cta-anim') as HTMLElement | null;
      if (ctaSection && ctaAnim) {
        ctaAnim.style.opacity = '0';
        ctaAnim.style.transform = 'translateY(30px) scale(0.98)';

        const ctaObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              ctaAnim.style.opacity = '1';
              ctaAnim.style.transform = 'translateY(0) scale(1)';
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });

        ctaObserver.observe(ctaSection);
      }
    });
  </script>
