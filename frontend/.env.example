# CivicConnect frontend — environment template
#
# Copy to `.env` and adjust. Both variables are optional; the defaults below
# run the UI on mock data with no backend required.

# Set to "false" to call the real FastAPI backend instead of mock data.
PUBLIC_USE_MOCK=false

# Base URL of the CivicConnect API (see backend/main.py).
PUBLIC_API_BASE=http://localhost:8000
