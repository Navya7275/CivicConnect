# CivicConnect frontend — environment template
#
# You do not need this file. Copy it to `.env` only if you want to change a
# default.
#
# The defaults call the real backend on localhost:8000, because that is what
# you almost always want, and because a missing config file should never
# silently turn the app into a simulation of itself.

# Set to "true" to answer from the built-in simulator instead of the backend.
#
# Only useful for frontend work with no backend running. The simulator returns
# canned text that looks exactly like a real answer, so leave this alone unless
# you have a reason, and never set it for a demo.
#
# PUBLIC_USE_MOCK=true

# Where the FastAPI backend is listening. Defaults to http://localhost:8000,
# which is what `uvicorn backend.main:app --reload` serves.
#
# PUBLIC_API_BASE=http://localhost:8000
