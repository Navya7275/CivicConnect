# CivicConnect — environment template
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. Never commit real keys.

# --- Database [Harshit] ------------------------------------------------
# Falls back to a local SQLite file if unset, which is fine for development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicconnect

# --- Embeddings [Ayushi / Harshit] -------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM provider [Ayushi / Navya] -------------------------------------
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- API server [Navya] ------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of origins allowed to call the API.
# The Astro dev server runs on 4321.
CORS_ORIGINS=http://localhost:4321,http://localhost:3000
