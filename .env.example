# CivicConnect — environment template
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. Never commit real keys.

# --- Database [Harshit] ------------------------------------------------
# Leave this commented out unless you are actually running PostgreSQL.
#
# Commented out, the app falls back to a local SQLite file
# (sqlite:///./civicconnect.db), which is what the Dockerfile uses and is fine
# for development, the test suite and the demo.
#
# Setting it to a Postgres URL you are not running breaks `pytest`: the backend
# tests call load_dotenv(), which puts this value in the environment, and the
# data tests then try to connect and fail on a missing Postgres driver.
#
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicconnect

# --- Embeddings [Ayushi / Harshit] -------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM provider [Ayushi / Navya] -------------------------------------
# Get a free key at https://console.groq.com
# Left blank on purpose. This is the template, not the running config -- the
# app reads .env, so a key here would not make anything work. The shared key
# lives in the committed .env for now, and is being rotated once the team has
# finished verifying the stack.
GROQ_API_KEY=
#
# Groq retires model IDs on a schedule, and a retired ID makes every /query
# return 500 with `model_not_found`. llama-3.3-70b-versatile, which this file
# used to pin, was shut down on 2026-08-16.
#
# If synthesis starts failing with a 404, the ID below has been retired too.
# Ask your own key what it can actually serve, and pick one from the list:
#
#   python -c "from dotenv import load_dotenv; load_dotenv(); from groq import Groq; print('\n'.join(sorted(m.id for m in Groq().models.list().data)))"
#
# Two IDs are verified working as of 2026-11-14: qwen/qwen3.8-27b, the default,
# which the answer formatting in synthesis.py was written against, and
# openai/gpt-oss-120b. Swapping between them needs no code change.
#
# Record the ID that produced the Phase E evaluation numbers in the report:
# the figures are not reproducible without it.
GROQ_MODEL=qwen/qwen3.8-27b

# --- API server [Navya] ------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of origins allowed to call the API.
# The Astro dev server runs on 4321.
CORS_ORIGINS=http://localhost:4321,http://localhost:3000
